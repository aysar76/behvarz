# Environment variables

# PostgreSQL database (Prisma 7 + @prisma/adapter-pg). For Neon, use the
# connection string provided by the Neon console (pooled or direct).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# نمایش کد تأیید موقت در UI فقط برای تست محلی. مقدار امن پیش‌فرض false است؛
# کد فقط وقتی دقیقاً true باشد در پاسخ API/UI دیده می‌شود.
DEV_SHOW_OTP=false