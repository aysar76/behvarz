generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// NOTE (فاز ۲): هویت، احراز هویت و پروفایل حرفه‌ای.
// هیچ داده بیمار در مدل داده وجود ندارد (رجوع به docs/data-privacy-rules.md).

enum Role {
  guest
  member
  verified_member
  mentor
  circle_facilitator
  content_moderator
  admin
  super_admin
}

enum MembershipStatus {
  none
  pending
  verified
  rejected
}

enum Visibility {
  public
  members
  private
}

// NOTE (فاز ۳): اتاق مسئله — هسته محصول.
// هیچ داده بیمار در مدل داده وجود ندارد (رجوع به docs/data-privacy-rules.md).

enum ProblemStatus {
  open
  discussing
  solved
  archived
}

enum ProblemUrgency {
  low
  medium
  high
  critical
}

enum ProblemBarrierType {
  resources
  knowledge
  process
  community
  equipment
  other
}

enum ProblemResultOutcome {
  successful
  partial
  unsuccessful
}

enum ModerationState {
  visible
  hidden
  removed
}

enum ReportStatus {
  pending
  reviewing
  resolved
  rejected
}

// NOTE (فاز ۴): بانک تجربه‌های میدانی.
// هیچ داده بیمار در مدل داده وجود ندارد (رجوع به docs/data-privacy-rules.md).

enum ExperienceStatus {
  user_generated
  under_review
  reviewed
  featured
  archived
}

enum ExperienceReuseOutcome {
  successful
  partial
  unsuccessful
}

// NOTE (فاز ۵): تعاملات حرفه‌ای و سرمایه روایت (پایه).
// دنبال‌کردن، ذخیره محتوا و «تشکر حرفه‌ای» به‌جای لایک عمومی.
// هیچ داده بیمار در مدل داده وجود ندارد (رجوع به docs/data-privacy-rules.md).

enum FollowTargetType {
  tag
  problem
  experience
  user
}

enum SavedTargetType {
  problem
  experience
}

enum ThanksTargetType {
  answer
  experience
}

// NOTE (فاز ۶): حلقه‌های همیار.
// حلقه‌ها گروه‌های کوچک (۵ تا ۱۲ نفره) و «درخواست همیار» جفت‌سازی دونفره است.
// هیچ داده بیمار در مدل داده وجود ندارد (رجوع به docs/data-privacy-rules.md).

enum CircleStatus {
  active
  archived
}

enum CircleMembershipRole {
  member
  facilitator
}

enum CircleMembershipStatus {
  active
  left
  removed
}

enum CircleJoinRequestStatus {
  pending
  approved
  rejected
  canceled
}

enum CircleInviteStatus {
  pending
  accepted
  declined
}

enum PeerHelpRequestStatus {
  open
  matched
  completed
  closed
  canceled
}

enum PeerOfferStatus {
  pending
  accepted
  rejected
  withdrawn
}

enum PeerOfferInitiator {
  requester
  helper
}

enum PeerCooperationStatus {
  active
  completed
  closed
}

enum PeerCooperationReportStatus {
  pending
  resolved
  rejected
}

enum PeerCooperationReportReason {
  abusive
  harassment
  off_topic
  sensitive_info
  other
}

// NOTE (فاز ۷): حکمرانی محتوا و ایمنی.
// وضعیت حساب کاربر، تاریخچه تصمیم ناظر، فرآیند اعتراض و واژه‌های حساس قابل مدیریت.
// هیچ داده بیمار در مدل داده وجود ندارد (رجوع به docs/data-privacy-rules.md).

enum AccountStatus {
  active
  warned
  restricted
  suspended
}

enum ModerationTargetType {
  problem
  answer
  experience
  user
}

enum ModerationAction {
  warn
  restrict
  suspend
  lift
  hide_content
  unhide_content
  remove_content
  restore_content
}

enum AppealStatus {
  pending
  approved
  rejected
}

enum AppealTargetType {
  problem
  answer
  experience
  account
}

model User {
  id                  String           @id @default(cuid())
  phone               String           @unique
  role                Role             @default(member)
  membershipStatus    MembershipStatus @default(none)
  displayName         String?
  province            String?
  city                String?
  workYears           String?
  bio                 String?
  visibility          Visibility       @default(members)
  onboardingCompleted Boolean          @default(false)
  willingToHelp       Boolean          @default(false)
  accountStatus       AccountStatus    @default(active)
  accountStatusReason String?
  accountStatusAt     DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  skills             UserSkill[]
  interests          UserInterest[]
  sessions           Session[]
  membershipRequests MembershipRequest[]
  auditLogs          AuditLog[]
  problems           Problem[]
  problemAnswers     ProblemAnswer[]
  helpfulMarks       ProblemAnswerHelpful[]
  problemReports     ContentReport[]
  experiences        Experience[]
  experienceReuses   ExperienceReuse[]
  follows            Follow[]
  savedItems         SavedItem[]
  thanks             ProfessionalThanks[]
  thanksReceived     ProfessionalThanks[] @relation("thanksReceived")
  circleFacilitator  Circle[]              @relation("circleFacilitator")
  circleMemberships  CircleMembership[]
  circleJoinRequests CircleJoinRequest[]
  circleInvitee      CircleInvite[]        @relation("circleInvitee")
  circleInviter      CircleInvite[]        @relation("circleInviter")
  circleMeetings     CircleMeeting[]
  peerHelpRequests   PeerHelpRequest[]     @relation("peerRequester")
  peerOffers         PeerOffer[]
  peerCooperationsR  PeerCooperation[]     @relation("peerCooperationRequester")
  peerCooperationsH  PeerCooperation[]     @relation("peerCooperationHelper")
  peerMessages       PeerMessage[]
  peerReports        PeerCooperationReport[]
  moderationDecisions ModerationDecision[]     @relation("moderationDecisionMaker")
  appeals             Appeal[]                 @relation("appealAuthor")
  appealsDecided      Appeal[]                 @relation("appealDecisionMaker")
  sensitiveTerms      SensitiveTerm[]          @relation("sensitiveTermCreator")
}

model Problem {
  id               String                @id @default(cuid())
  authorId         String
  author           User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title            String
  description      String
  context          String?
  barrierType      ProblemBarrierType    @default(other)
  actionsTaken     String?
  expectedOutcome  String?
  urgency          ProblemUrgency        @default(medium)
  isAnonymous      Boolean               @default(false)
  status           ProblemStatus         @default(open)
  isDraft          Boolean               @default(false)
  needsReview      Boolean               @default(false)
  moderation       ModerationState       @default(visible)
  moderationNote   String?
  conclusion       String?
  selectedAnswerId String?
  resultSummary    String?
  resultOutcome    ProblemResultOutcome?
  publishedAt      DateTime?
  solvedAt         DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  answers       ProblemAnswer[]
  tags          ProblemTag[]
  statusHistory ProblemStatusChange[]
  reports       ContentReport[]
  experiences   Experience[]

  @@index([status])
  @@index([moderation])
  @@index([authorId])
}

model ProblemAnswer {
  id                     String          @id @default(cuid())
  problemId              String
  problem                Problem         @relation(fields: [problemId], references: [id], onDelete: Cascade)
  authorId               String
  author                 User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body                   String
  isClarificationRequest Boolean         @default(false)
  isSelectedSolution     Boolean         @default(false)
  moderation             ModerationState @default(visible)
  moderationNote         String?
  needsReview            Boolean         @default(false)
  helpfulCount           Int             @default(0)
  thanksCount            Int             @default(0)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  helpfulMarks ProblemAnswerHelpful[]
  reports      ContentReport[]
  references   ExperienceReference[]
  thanks       ProfessionalThanks[]

  @@index([problemId])
}

model ProblemAnswerHelpful {
  answerId  String
  userId    String
  answer    ProblemAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([answerId, userId])
}

model ProblemStatusChange {
  id        String         @id @default(cuid())
  problemId String
  problem   Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  from      ProblemStatus?
  to        ProblemStatus
  changedBy String
  note      String?
  createdAt DateTime       @default(now())

  @@index([problemId])
}

model Tag {
  id          String          @id @default(cuid())
  name        String          @unique
  isActive    Boolean         @default(true)
  problems    ProblemTag[]
  experiences ExperienceTag[]
}

model ProblemTag {
  problemId String
  tagId     String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemId, tagId])
  @@index([tagId])
}

model Experience {
  id              String           @id @default(cuid())
  authorId        String
  author          User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  slug            String           @unique
  title           String
  situation       String
  conditions      String?
  action          String
  resources       String?
  challenges      String?
  result          String
  lessons         String?
  suggestion      String?
  status           ExperienceStatus @default(user_generated)
  isDraft          Boolean          @default(false)
  needsReview      Boolean          @default(false)
  moderation       ModerationState  @default(visible)
  moderationNote   String?
  thanksCount      Int              @default(0)
  sourceProblemId  String?
  sourceProblem   Problem?         @relation(fields: [sourceProblemId], references: [id], onDelete: SetNull)
  publishedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tags       ExperienceTag[]
  references ExperienceReference[]
  reuses     ExperienceReuse[]
  reports    ContentReport[]
  thanks     ProfessionalThanks[]

  @@index([status])
  @@index([moderation])
  @@index([authorId])
  @@index([sourceProblemId])
}

model ExperienceTag {
  experienceId String
  tagId        String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([experienceId, tagId])
  @@index([tagId])
}

model ExperienceReference {
  id           String        @id @default(cuid())
  experienceId String
  experience   Experience    @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  answerId     String
  answer       ProblemAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  @@unique([experienceId, answerId])
  @@index([experienceId])
  @@index([answerId])
}

model ExperienceReuse {
  id           String                 @id @default(cuid())
  experienceId String
  experience   Experience             @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcome      ExperienceReuseOutcome
  summary      String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([experienceId, userId])
  @@index([experienceId])
  @@index([userId])
}

// NOTE (فاز ۵): تعاملات حرفه‌ای — دنبال‌کردن.
// targetType + targetId مشخص می‌کند چه چیزی دنبال شده است (برچسب/مسئله/تجربه/عضو).
// دنبال‌کردن عضو فقط با رعایت سیاست حریم خصوصی انجام می‌شود (visibility).
model Follow {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType FollowTargetType
  targetId   String
  createdAt  DateTime         @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

// NOTE (فاز ۵): ذخیره محتوا (خواندن بعدی).
model SavedItem {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType SavedTargetType
  targetId   String
  createdAt  DateTime        @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

// NOTE (فاز ۵): «تشکر حرفه‌ای» به‌جای لایک عمومی.
// کاربر به ازای هر هدف فقط یک‌بار می‌تواند تشکر کند.
model ProfessionalThanks {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType ThanksTargetType
  targetId   String
  answerId   String?
  answer     ProblemAnswer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  experienceId String?
  experience Experience?      @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  receivedById String
  receivedBy   User           @relation("thanksReceived", fields: [receivedById], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model ContentReport {
  id            String         @id @default(cuid())
  reporterId    String
  reporter      User           @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  problemId     String?
  problem       Problem?       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  answerId      String?
  answer        ProblemAnswer? @relation(fields: [answerId], references: [id], onDelete: Cascade)
  experienceId  String?
  experience    Experience?    @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  reason        String
  note          String?
  status        ReportStatus   @default(pending)
  reviewedBy    String?
  reviewedAt    DateTime?
  moderatorNote String?
  createdAt     DateTime       @default(now())

  @@index([status])
  @@index([problemId])
  @@index([answerId])
  @@index([experienceId])
}

// NOTE (فاز ۶): حلقه همیار — گروه کوچک ۵ تا ۱۲ نفره با راهبر (facilitator).
model Circle {
  id            String       @id @default(cuid())
  name          String
  description   String
  topic         String?
  province      String?
  capacity      Int          @default(12)
  status        CircleStatus @default(active)
  facilitatorId String
  facilitator   User         @relation("circleFacilitator", fields: [facilitatorId], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  memberships  CircleMembership[]
  joinRequests CircleJoinRequest[]
  invites      CircleInvite[]
  meetings     CircleMeeting[]

  @@index([status])
  @@index([facilitatorId])
}

model CircleMembership {
  id       String                 @id @default(cuid())
  circleId String
  circle   Circle                 @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId   String
  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     CircleMembershipRole   @default(member)
  status   CircleMembershipStatus @default(active)
  joinedAt DateTime               @default(now())
  leftAt   DateTime?

  @@unique([circleId, userId])
  @@index([circleId])
  @@index([userId])
}

model CircleJoinRequest {
  id         String                 @id @default(cuid())
  circleId   String
  circle     Circle                 @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  message    String?
  status     CircleJoinRequestStatus @default(pending)
  reviewedAt DateTime?
  createdAt  DateTime               @default(now())

  @@unique([circleId, userId])
  @@index([circleId])
  @@index([userId])
  @@index([status])
}

model CircleInvite {
  id          String             @id @default(cuid())
  circleId    String
  circle      Circle             @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation("circleInvitee", fields: [userId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User               @relation("circleInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  message     String?
  status      CircleInviteStatus @default(pending)
  createdAt   DateTime           @default(now())
  respondedAt DateTime?

  @@unique([circleId, userId])
  @@index([circleId])
  @@index([userId])
  @@index([status])
}

// جلسه و خروجی دوره‌ای حلقه.
model CircleMeeting {
  id          String   @id @default(cuid())
  circleId    String
  circle      Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  title       String
  agenda      String?
  scheduledAt DateTime?
  summary     String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([circleId])
}

// NOTE (فاز ۶): درخواست همیار — فرد دارای مسئله، همیار مرتبط با تجربه مشابه می‌خواهد.
// برچسب‌ها به‌صورت Json ذخیره می‌شوند؛ محتوای مسئله ناشناس‌سازی‌شده است (بدون داده بیمار).
model PeerHelpRequest {
  id          String                @id @default(cuid())
  requesterId String
  requester   User                  @relation("peerRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  title       String
  description String
  barrierType ProblemBarrierType    @default(other)
  tags        Json?
  province    String?
  status      PeerHelpRequestStatus @default(open)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  offers       PeerOffer[]
  cooperations PeerCooperation[]

  @@index([requesterId])
  @@index([status])
  @@index([barrierType])
}

model PeerOffer {
  id            String            @id @default(cuid())
  helpRequestId String
  helpRequest   PeerHelpRequest   @relation(fields: [helpRequestId], references: [id], onDelete: Cascade)
  helperId      String
  helper        User              @relation(fields: [helperId], references: [id], onDelete: Cascade)
  initiator     PeerOfferInitiator
  message       String?
  status        PeerOfferStatus   @default(pending)
  createdAt     DateTime          @default(now())
  respondedAt   DateTime?

  @@unique([helpRequestId, helperId])
  @@index([helpRequestId])
  @@index([helperId])
  @@index([status])
}

model PeerCooperation {
  id              String                  @id @default(cuid())
  helpRequestId   String?
  helpRequest     PeerHelpRequest?        @relation(fields: [helpRequestId], references: [id], onDelete: SetNull)
  requesterId     String
  requester       User                    @relation("peerCooperationRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  helperId        String
  helper          User                    @relation("peerCooperationHelper", fields: [helperId], references: [id], onDelete: Cascade)
  goal            String?
  status          PeerCooperationStatus   @default(active)
  outcomeSummary  String?
  requesterRating Int?
  helperRating    Int?
  completedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  messages PeerMessage[]
  reports  PeerCooperationReport[]

  @@index([requesterId])
  @@index([helperId])
  @@index([status])
}

// گفت‌وگوی محدود و موضوع‌محور (Thread-Based؛ بدون Chat بلادرنگ در MVP).
model PeerMessage {
  id            String          @id @default(cuid())
  cooperationId String
  cooperation   PeerCooperation @relation(fields: [cooperationId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime        @default(now())

  @@index([cooperationId])
}

model PeerCooperationReport {
  id            String                       @id @default(cuid())
  cooperationId String
  cooperation   PeerCooperation              @relation(fields: [cooperationId], references: [id], onDelete: Cascade)
  reporterId    String
  reporter      User                         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason        PeerCooperationReportReason
  note          String?
  status        PeerCooperationReportStatus  @default(pending)
  reviewedAt    DateTime?
  createdAt     DateTime                     @default(now())

  @@index([cooperationId])
  @@index([status])
}

model OtpCode {
  id          String    @id @default(cuid())
  phone       String
  codeHash    String
  purpose     String    @default("login")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone, purpose])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model MembershipRequest {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     MembershipStatus @default(pending)
  note       String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([status])
}

model Skill {
  id    String      @id @default(cuid())
  name  String      @unique
  users UserSkill[]
}

model UserSkill {
  userId  String
  skillId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model Interest {
  id    String         @id @default(cuid())
  name  String         @unique
  users UserInterest[]
}

model UserInterest {
  userId     String
  interestId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
}

// NOTE (فاز ۷): تاریخچه تصمیم ناظر — هر اقدام حساس نظارتی (اخطار، محدودسازی،
// تعلیق، مخفی‌سازی، حذف نرم و...) به‌صورت جداگانه ثبت می‌شود تا امکان بازبینی
// و بازگشت تصمیم اشتباه وجود داشته باشد.
model ModerationDecision {
  id          String               @id @default(cuid())
  moderatorId String
  moderator   User                 @relation("moderationDecisionMaker", fields: [moderatorId], references: [id], onDelete: Cascade)
  targetType  ModerationTargetType
  targetId    String
  action      ModerationAction
  reason      String?
  note        String?
  createdAt   DateTime             @default(now())

  @@index([targetType, targetId])
  @@index([moderatorId])
}

// NOTE (فاز ۷): فرآیند اعتراض — کاربر می‌تواند به تصمیم ناظر روی محتوای خودش یا
// وضعیت حساب خود اعتراض کند و ناظر با بررسی، آن را می‌پذیرد یا رد می‌کند.
model Appeal {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation("appealAuthor", fields: [userId], references: [id], onDelete: Cascade)
  targetType    AppealTargetType
  targetId      String
  reason        String
  status        AppealStatus     @default(pending)
  decisionNote  String?
  decidedBy     String?
  decidedByUser User?            @relation("appealDecisionMaker", fields: [decidedBy], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  createdAt     DateTime         @default(now())

  @@index([status])
  @@index([userId])
  @@index([targetType, targetId])
}

// NOTE (فاز ۷): واژه‌ها و الگوهای حساس قابل مدیریت توسط ناظر. این واژه‌ها در
// کنار الگوهای ثابت (`lib/content-safety.ts`) برای علامت‌گذاری محتوای حساس استفاده می‌شوند.
model SensitiveTerm {
  id           String   @id @default(cuid())
  term         String   @unique
  description  String?
  isActive     Boolean  @default(true)
  createdById  String?
  createdBy    User?    @relation("sensitiveTermCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
}
