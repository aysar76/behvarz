generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// NOTE (فاز ۲): هویت، احراز هویت و پروفایل حرفه‌ای.
// هیچ داده بیمار در مدل داده وجود ندارد (رجوع به docs/data-privacy-rules.md).

enum Role {
  guest
  member
  verified_member
  mentor
  circle_facilitator
  content_moderator
  admin
  super_admin
}

enum MembershipStatus {
  none
  pending
  verified
  rejected
}

enum Visibility {
  public
  members
  private
}

// NOTE (فاز ۳): اتاق مسئله — هسته محصول.
// هیچ داده بیمار در مدل داده وجود ندارد (رجوع به docs/data-privacy-rules.md).

enum ProblemStatus {
  open
  discussing
  solved
  archived
}

enum ProblemUrgency {
  low
  medium
  high
  critical
}

enum ProblemBarrierType {
  resources
  knowledge
  process
  community
  equipment
  other
}

enum ProblemResultOutcome {
  successful
  partial
  unsuccessful
}

enum ModerationState {
  visible
  hidden
  removed
}

enum ReportStatus {
  pending
  reviewing
  resolved
  rejected
}

model User {
  id                  String            @id @default(cuid())
  phone               String            @unique
  role                Role              @default(member)
  membershipStatus    MembershipStatus  @default(none)
  displayName         String?
  province            String?
  city                String?
  workYears           String?
  bio                 String?
  visibility          Visibility        @default(members)
  onboardingCompleted Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  skills             UserSkill[]
  interests          UserInterest[]
  sessions           Session[]
  membershipRequests MembershipRequest[]
  auditLogs          AuditLog[]
  problems           Problem[]
  problemAnswers     ProblemAnswer[]
  helpfulMarks       ProblemAnswerHelpful[]
  problemReports     ContentReport[]
}

model Problem {
  id               String                @id @default(cuid())
  authorId         String
  author           User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title            String
  description      String
  context          String?
  barrierType      ProblemBarrierType    @default(other)
  actionsTaken     String?
  expectedOutcome  String?
  urgency          ProblemUrgency        @default(medium)
  isAnonymous      Boolean               @default(false)
  status           ProblemStatus         @default(open)
  isDraft          Boolean               @default(false)
  needsReview      Boolean               @default(false)
  moderation       ModerationState       @default(visible)
  moderationNote   String?
  conclusion       String?
  selectedAnswerId String?
  resultSummary    String?
  resultOutcome    ProblemResultOutcome?
  publishedAt      DateTime?
  solvedAt         DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  answers       ProblemAnswer[]
  tags          ProblemTag[]
  statusHistory ProblemStatusChange[]
  reports       ContentReport[]

  @@index([status])
  @@index([moderation])
  @@index([authorId])
}

model ProblemAnswer {
  id                    String                @id @default(cuid())
  problemId             String
  problem               Problem               @relation(fields: [problemId], references: [id], onDelete: Cascade)
  authorId              String
  author                User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body                  String
  isClarificationRequest Boolean              @default(false)
  isSelectedSolution    Boolean               @default(false)
  moderation            ModerationState       @default(visible)
  moderationNote        String?
  needsReview           Boolean               @default(false)
  helpfulCount          Int                   @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  helpfulMarks ProblemAnswerHelpful[]
  reports      ContentReport[]

  @@index([problemId])
}

model ProblemAnswerHelpful {
  answerId  String
  userId    String
  answer    ProblemAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([answerId, userId])
}

model ProblemStatusChange {
  id        String         @id @default(cuid())
  problemId String
  problem   Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  from      ProblemStatus?
  to        ProblemStatus
  changedBy String
  note      String?
  createdAt DateTime       @default(now())

  @@index([problemId])
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  problems ProblemTag[]
}

model ProblemTag {
  problemId String
  tagId     String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemId, tagId])
  @@index([tagId])
}

model ContentReport {
  id            String        @id @default(cuid())
  reporterId    String
  reporter      User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  problemId     String?
  problem       Problem?      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  answerId      String?
  answer        ProblemAnswer? @relation(fields: [answerId], references: [id], onDelete: Cascade)
  reason        String
  note          String?
  status        ReportStatus  @default(pending)
  reviewedBy    String?
  reviewedAt    DateTime?
  moderatorNote String?
  createdAt     DateTime      @default(now())

  @@index([status])
  @@index([problemId])
  @@index([answerId])
}

model OtpCode {
  id          String    @id @default(cuid())
  phone       String
  codeHash    String
  purpose     String    @default("login")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone, purpose])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model MembershipRequest {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     MembershipStatus @default(pending)
  note       String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([status])
}

model Skill {
  id    String       @id @default(cuid())
  name  String       @unique
  users UserSkill[]
}

model UserSkill {
  userId  String
  skillId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model Interest {
  id    String          @id @default(cuid())
  name  String          @unique
  users UserInterest[]
}

model UserInterest {
  userId     String
  interestId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
}